engine-strict=true
save-exact=true
# Dependencies ship prebuilt binaries (better-sqlite3 loads a per-platform prebuild), so no install script is
# needed. Without this, "npm ci" sees a binding.gyp and tries to compile better-sqlite3 from source, which
# fails on machines and Docker images with no C++ toolchain. It also blocks install-time code execution
# from dependencies. See ADR-007.
ignore-scripts=true
