{
	"name": "tessera",
	"private": true,
	"version": "0.3.0",
	"license": "AGPL-3.0-only",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run --project unit",
		"test:watch": "vitest --project unit",
		"test:integration": "vitest run --project integration --passWithNoTests",
		"test:e2e": "playwright test",
		"test:e2e:chromium": "node scripts/run-e2e.ts chromium",
		"test:e2e:firefox": "node scripts/run-e2e.ts firefox",
		"test:e2e:webkit": "node scripts/run-e2e.ts webkit",
		"test:e2e:all": "node scripts/run-e2e.ts chromium firefox webkit",
		"smoke": "node scripts/smoke.ts",
		"benchmark": "node scripts/benchmark.ts",
		"benchmark:stats": "node scripts/stats-benchmark.ts",
		"security:probe": "node scripts/security-probe.ts",
		"probe:remote-check": "node scripts/probe-remote-check.ts",
		"live:test": "node scripts/live-test.ts",
		"durability": "node scripts/durability-check.ts",
		"ops:check": "node scripts/ops-check.ts",
		"fixtures:scheduler": "node scripts/gen-scheduler-fixtures.ts",
		"licenses": "node scripts/check-licenses.ts",
		"audit:prod": "npm audit --omit=dev --audit-level=moderate",
		"db:generate": "drizzle-kit generate",
		"db:check": "drizzle-kit check",
		"schema:emit": "node scripts/emit-schema.ts",
		"schema:check": "node scripts/emit-schema.ts --check",
		"verify": "npm run check && npm run lint && npm run schema:check && npm run test && npm run test:integration"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.64.0",
		"@sveltejs/adapter-node": "6.0.0",
		"@sveltejs/kit": "3.0.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/better-sqlite3": "9.6.0",
		"@types/node": "24.19.2",
		"@vitest/coverage-v8": "5.0.3",
		"drizzle-kit": "0.31.11",
		"eslint": "10.12.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"fast-check": "4.10.2",
		"globals": "17.13.0",
		"jsdom": "30.1.2",
		"mermaid": "12.1.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"shiki": "4.5.0",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.1",
		"vite": "8.3.4",
		"vitest": "5.0.4"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"better-sqlite3": "13.0.3",
		"dompurify": "3.4.16",
		"drizzle-orm": "0.45.4",
		"marked": "18.1.0",
		"ts-fsrs": "5.4.2",
		"yaml": "2.9.1",
		"zod": "4.6.5"
	}
}
