{
	"name": "tessera",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run --project unit",
		"test:watch": "vitest --project unit",
		"test:integration": "vitest run --project integration --passWithNoTests",
		"test:e2e": "playwright test",
		"schema:emit": "node scripts/emit-schema.ts",
		"schema:check": "node scripts/emit-schema.ts --check",
		"verify": "npm run check && npm run lint && npm run schema:check && npm run test && npm run test:integration"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.64.0",
		"@sveltejs/adapter-node": "6.0.0",
		"@sveltejs/kit": "3.0.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "24.19.2",
		"eslint": "10.12.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.1",
		"vite": "8.3.4",
		"vitest": "4.1.11"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"yaml": "2.9.1",
		"zod": "4.6.5"
	}
}
